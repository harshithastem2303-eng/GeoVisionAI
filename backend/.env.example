# Copy to backend/.env and adjust if needed.
# Homebrew PostgreSQL on macOS normally needs no password and uses your
# macOS username as the DB role, so the defaults below usually just work.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=wastraq_demo
# DB_USER defaults to your shell $USER
# DB_USER=benny
DB_PASSWORD=

API_HOST=127.0.0.1
API_PORT=8000

# Where the surveyed frontage photos live (PROP-001.jpg ... PROP-016.jpg).
# Survey QA / human verification only - never used for live association.
PHOTO_DIR=~/properties

# --- GIS association tuning (metres) ---
# Radius used by ST_DWithin when the point is outside every service zone.
SEARCH_RADIUS_M=15
# Max distance to the nearest zone that may still auto-associate.
AUTO_MAX_DISTANCE_M=3
# Required separation between nearest and runner-up before auto-associating.
AMBIGUITY_MARGIN_M=2
# Confidence floor for auto-association.
MIN_AUTO_CONFIDENCE=0.70
# Projected CRS for reference metre maths (UTM 43N covers the demo lane).
METRIC_SRID=32643

# --- LangSmith tracing (optional, OFF by default) ---
# Leave LANGSMITH_TRACING unset and the backend behaves exactly as before.
# Turn it on to record request -> association -> PostGIS query as one run.
# LANGSMITH_TRACING=1
# LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=wastraq-demo
# EU region or self-hosted: set the endpoint. Blank = LangSmith's default.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# One child span per SQL round trip (statement + row count, never the rows).
LANGSMITH_TRACE_SQL=1
# Paths never traced - dashboard polls and the MJPEG stream.
LANGSMITH_TRACE_EXCLUDE=/assets,/vision/stream,/vision/tracks,/vision/status,/health,/favicon.ico

# --- GeoVision edge ingestion ---
# Receiver for the Windows RealSense/RFID laptop:
#   POST /integrations/geovision/events
# Perception intake only - property association stays with PostGIS.
GEOVISION_ENABLED=1
# A camera track unseen for this long is no longer counted as active.
GEOVISION_TRACK_STALE_S=15
# A source silent for this long is reported offline on /integrations/geovision/status.
GEOVISION_DEVICE_STALE_S=60

# --- Windows episode mirror (WASTRAQ -> GeoVision, outbound) ---
# WASTRAQ pushes the id of the episode it decided is live, so a second RFID
# tap on the Windows laptop has something to point at. Advisory only: the
# mirror carries episode_id / track_id / association_status and NO property.
# Blank = mirroring off, which is correct with no edge attached. Never
# hard-code a laptop IP in source - set it here on demo morning.
# GEOVISION_EDGE_BASE_URL=http://192.168.1.42:8000
GEOVISION_EDGE_MIRROR_ENABLED=1
GEOVISION_EDGE_TIMEOUT_S=2.0
GEOVISION_EDGE_RETRIES=1

# --- evidence media (STEP 4A: playing the edge's clip on this Mac) ---
# The clip an EVIDENCE_READY announces lives on the WINDOWS machine. Its
# file_path is provenance and nothing else - no browser here can open it.
# WASTRAQ pulls the bytes over HTTP once, keeps them under the evidence root,
# and serves them from GET /evidence/{evidence_id}/media.
#
# Where the pulled bytes live. Defaults to <repo>/evidence, the same root the
# local rolling recorder writes to.
# EVIDENCE_MEDIA_ROOT=/absolute/path/to/wastraq-demo/evidence
# How to ask the edge for a clip when EVIDENCE_READY carried no file_url.
# Joined onto GEOVISION_EDGE_BASE_URL. Placeholders: {clip_id} {source_id} {event_id}
GEOVISION_CLIP_URL_TEMPLATE=/evidence/clips/{clip_id}/file
# Master switch. 0 = clips stay announced-but-not-held, and the dashboard
# says exactly that instead of pretending.
GEOVISION_CLIP_FETCH_ENABLED=1
# Pull as soon as EVIDENCE_READY lands, on a background thread. The ack to
# the edge never waits for it.
GEOVISION_CLIP_FETCH_ON_INGEST=1
# Generous next to GEOVISION_EDGE_TIMEOUT_S: this is a multi-megabyte file
# over site wifi, not a 2 s control message.
GEOVISION_CLIP_FETCH_TIMEOUT_S=20.0
# Backstop against a misconfigured edge, not a working limit.
GEOVISION_CLIP_MAX_BYTES=200000000

# --- collection episode engine ---
# Bound camera track + mapped service zone + dwell -> collection event.
EPISODE_ENGINE_ENABLED=1
# Seconds in one service zone before it counts as servicing that property.
EPISODE_DWELL_S=3.0
# Seconds out of it before the episode closes and writes its event.
EPISODE_LEAVE_GRACE_S=4.0
# Minimum gap between PostGIS association queries for one track (edge is 5 Hz).
EPISODE_MIN_ASSOC_INTERVAL_S=0.4
# Backstop for a stuck track.
EPISODE_MAX_DURATION_S=180
# Below this confidence the episode is flagged REVIEW and its event NEEDS_REVIEW.
EPISODE_REVIEW_CONFIDENCE=0.85
EPISODE_BINDING_TTL_S=900
# A trigger arriving just after the collector left still belongs to that episode.
EPISODE_TRIGGER_LATE_GRACE_S=30
EPISODE_EVIDENCE_LINK_WINDOW_S=120
# Only associate from depth the edge itself vouches for. Leave this on.
EPISODE_REQUIRE_DEPTH_VALID=1

# --- fixed camera pose (REQUIRED for episodes) ---
# Where the GeoVision camera stands, and the compass bearing of the direction
# it faces (degrees clockwise from true north: 0 = north, 90 = east).
# Unset (0/0) means no episode is ever created - the engine refuses to invent
# a position rather than guessing one. Survey these before the demo.
# CAMERA_ORIGIN_LAT=12.2943291
# CAMERA_ORIGIN_LON=76.6414898
# CAMERA_HEADING_DEG=90
CAMERA_OFFSET_RIGHT_M=0
CAMERA_OFFSET_FORWARD_M=0
