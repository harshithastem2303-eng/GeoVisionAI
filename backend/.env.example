# GeoVision environment configuration.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is git-ignored. Never commit real credentials.
# Every value below is optional -- config.py has a safe default for all of
# them except GEOVISION_DB_PASSWORD.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
GEOVISION_HOST=0.0.0.0
GEOVISION_PORT=8000
GEOVISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
GEOVISION_LOG_LEVEL=INFO
# Per-frame detection dump. Debugging only -- leave false in normal use.
GEOVISION_VERBOSE_FRAMES=false

# ---------------------------------------------------------------------------
# Camera
# ---------------------------------------------------------------------------
# realsense | mock
# Use "mock" to run the API, the dashboard and the tests with no hardware.
GEOVISION_CAMERA_BACKEND=realsense
GEOVISION_CAMERA_WIDTH=640
GEOVISION_CAMERA_HEIGHT=480
GEOVISION_CAMERA_FPS=30

# Explicit RealSense serial number. Set this whenever more than one camera
# may be attached -- startup binds the serial instead of guessing.
GEOVISION_VISION_SERIAL=

GEOVISION_ENABLE_COLOR=true
GEOVISION_ENABLE_DEPTH=true
GEOVISION_FRAME_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Detection / tracking
# ---------------------------------------------------------------------------
GEOVISION_YOLO_MODEL=yolo11n.pt
GEOVISION_YOLO_CONFIDENCE=0.40
GEOVISION_TRACKER=botsort.yaml

# Dataset-collection helper. Off by default.
GEOVISION_SAVE_PERSON_CROPS=false
GEOVISION_CROP_INTERVAL_S=1.0
GEOVISION_CROP_MIN_CONF=0.60
GEOVISION_CROP_MAX_PER_ID=50

# ---------------------------------------------------------------------------
# RFID evidence zone (image coordinates: x1,y1,x2,y2)
# ---------------------------------------------------------------------------
# The rectangle in the camera frame that covers the physical RFID reader.
# MUST be re-measured for the real installation -- the default is a guess.
GEOVISION_RFID_ZONE=220,240,420,470

# Seconds either side of a tap in which tracked people are considered.
GEOVISION_RFID_MATCH_WINDOW_S=2.0
# Minimum fraction of a person's box that must lie inside the zone.
GEOVISION_RFID_MIN_OVERLAP=0.15
# Zone-overlap tie-break, used only when no depth is available at all.
GEOVISION_RFID_AMBIGUITY_MARGIN=0.20
# The tapper is the person closest to the camera. They must be at least this
# many metres nearer than the next person, or the tap is AMBIGUOUS. Widen it
# for a crowded lane; narrow it when depth is clean and people queue up.
GEOVISION_RFID_DEPTH_MARGIN_M=0.5
# The reader holds a UID while the card sits on it, so one physical tap
# arrives as several reads. Within this many seconds of a binding being made,
# another read of the same card by the same collector returns that binding
# unchanged instead of being taken for the collector's next instruction.
GEOVISION_RFID_BIND_ECHO_S=2.0

# ---------------------------------------------------------------------------
# Collection episodes (mirrored from WASTRAQ -- nothing is decided here)
# ---------------------------------------------------------------------------
# WASTRAQ pushes open episodes to POST /episodes/active so a second RFID tap
# has a subject. GeoVision opens none of its own and stores no property id.
# How long a pushed episode stays live without an update from WASTRAQ.
GEOVISION_EPISODE_MAX_AGE_S=180
# A bounced reader or a retried POST must raise one trigger, not several.
GEOVISION_NON_SEGREGATION_DEBOUNCE_S=10

# ---------------------------------------------------------------------------
# Worker binding lifecycle
# ---------------------------------------------------------------------------
# How long a binding survives the track being out of view (occlusion grace).
GEOVISION_BINDING_GRACE_S=20
# Absolute ceiling on a binding's lifetime.
GEOVISION_BINDING_MAX_AGE_S=3600

# ---------------------------------------------------------------------------
# Depth
# ---------------------------------------------------------------------------
GEOVISION_DEPTH_ENABLED=true
GEOVISION_DEPTH_PATCH_RADIUS=4
GEOVISION_DEPTH_MIN_M=0.2
GEOVISION_DEPTH_MAX_M=12.0

# ---------------------------------------------------------------------------
# Location
# ---------------------------------------------------------------------------
# phone | browser | mock
GEOVISION_LOCATION_PROVIDER=phone
GEOVISION_LOCATION_MAX_AGE_S=30
GEOVISION_LOCATION_MAX_ACCURACY_M=100

GEOVISION_MOCK_LAT=12.2942090
GEOVISION_MOCK_LON=76.6417020
GEOVISION_MOCK_ACCURACY_M=10

# ---------------------------------------------------------------------------
# Source identity
# ---------------------------------------------------------------------------
# Which edge node these observations came from. Change per camera/vehicle.
WASTRAQ_SOURCE_ID=GEOVISION-D455-01
GEOVISION_GPS_SOURCE_ID=GEOVISION-GPS-01
GEOVISION_RFID_SOURCE_ID=GEOVISION-RFID-01

# ---------------------------------------------------------------------------
# WASTRAQ outbound integration
# ---------------------------------------------------------------------------
# Where the WASTRAQ backend is listening. NEVER hard-code this in source --
# the laptop's IP changes between demos.
#   macOS:   ipconfig getifaddr en0
#   Windows: ipconfig  (IPv4 Address of the active adapter)
WASTRAQ_BASE_URL=http://192.168.1.23:8000

# Off by default. Nothing is sent until this is true AND a base URL is set.
WASTRAQ_INTEGRATION_ENABLED=false

WASTRAQ_EVENTS_PATH=/integrations/geovision/events

# Short on purpose: an unreachable WASTRAQ must not hold the sender thread.
WASTRAQ_TIMEOUT_S=2.0

# Outbound TRACK_UPDATE rate PER TRACK. Camera tracking stays at full FPS;
# only publishing is throttled. 0 disables track publishing entirely.
WASTRAQ_TRACK_PUBLISH_HZ=5

# Bounded retry buffer. When full, the OLDEST event is dropped.
WASTRAQ_QUEUE_MAX=500
WASTRAQ_RETRY_BACKOFF_S=5
WASTRAQ_MAX_ATTEMPTS=5

# Optional liveness beat, seconds. 0 disables it.
WASTRAQ_HEARTBEAT_S=0

# Attach the coarse fix to TRACK_UPDATE events, in its own "gps" object.
WASTRAQ_INCLUDE_GPS=true

# ---------------------------------------------------------------------------
# Evidence clip buffer
# ---------------------------------------------------------------------------
GEOVISION_EVIDENCE_ENABLED=true
# Clips are written here. Git-ignored; never commit footage.
GEOVISION_EVIDENCE_DIR=
# Rolling window kept in memory.
GEOVISION_EVIDENCE_BUFFER_S=20
# Frames retained per second -- deliberately below camera FPS.
GEOVISION_EVIDENCE_CAPTURE_HZ=10
# Clip window around a trigger: T-PRE .. T+POST.
GEOVISION_EVIDENCE_PRE_S=10
GEOVISION_EVIDENCE_POST_S=3
GEOVISION_EVIDENCE_JPEG_QUALITY=70
# Save a clip automatically when an RFID tap resolves to a track.
GEOVISION_EVIDENCE_AUTO_ON_RFID=true
# Save a clip when a bound collector flags non-segregation. This is the clip
# the dashboard shows beside a NON_SEGREGATED property -- keep it on.
GEOVISION_EVIDENCE_AUTO_ON_NON_SEGREGATION=true

# --- Serving clips back to WASTRAQ ----------------------------------------
# Read-only retrieval at GET /evidence/clips/{clip_id}/file, served only from
# GEOVISION_EVIDENCE_DIR and only by clip id. This is how WASTRAQ turns an
# EVIDENCE_READY reference into playable bytes. Off means the reference is
# still announced but carries no URL.
GEOVISION_EVIDENCE_SERVE_ENABLED=true
# How WASTRAQ reaches THIS machine, e.g. http://192.168.1.42:8000. Only used
# to make the announced file_url absolute; left empty the event carries the
# relative endpoint and WASTRAQ resolves it against the GeoVision base URL it
# already holds. Not a secret, and never a credential -- the endpoint is
# unauthenticated, so bind the API to the LAN, not to the internet.
GEOVISION_PUBLIC_BASE_URL=
# Clips larger than this are announced with sha256: null rather than delaying
# the event while they are hashed. 256 MiB.
GEOVISION_EVIDENCE_HASH_MAX_BYTES=268435456

# ---------------------------------------------------------------------------
# Database (legacy collector / RFID CRUD)
# ---------------------------------------------------------------------------
GEOVISION_DB_HOST=localhost
GEOVISION_DB_PORT=5432
GEOVISION_DB_NAME=geovision
GEOVISION_DB_USER=geovision_user
GEOVISION_DB_PASSWORD=
