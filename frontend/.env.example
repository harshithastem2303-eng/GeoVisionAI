# Copy to .env.local and set for this machine / this network session.
# .env.local is git-ignored; this file is the documentation of what exists.

# ESP32 + RC522 RFID reader. The board is an HTTP server exposing
# /start-scan, /latest and /stop-scan. Its address changes with the network.
# Read by src/esp32.js, which both the RFID scanner page and the
# "Assign RFID -> Scan RFID Card" modal go through.
VITE_ESP32_BASE_URL=http://192.168.0.127

# GeoVision backend. Optional: defaults to port 8000 on the host that served
# the dashboard, so a phone at http://<laptop-ip>:5173 works with no change.
# VITE_API_BASE=http://127.0.0.1:8000
